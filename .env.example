# Copy to .env and adjust. Only needed if you want Postgres instead of SQLite.
# SQLite (default, zero setup):
# DATABASE_URL=sqlite:///economic_indicators.db

# Postgres (matches the bundled docker-compose service):
DATABASE_URL=postgresql+psycopg2://etl:etl@localhost:5432/economics

# Optional runtime knobs
ETL_REQUEST_TIMEOUT=30
ETL_MAX_RETRIES=3
